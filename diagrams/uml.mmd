classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +edit_task(title: str, duration: int, priority: str) None
        +remove_task(title: str) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str frequency
        +priority_value() int
    }

    class Scheduler {
        +Owner owner
        +sort_tasks(tasks: list~Task~) list~Task~
        +generate_plan(start_minute: int) DailyPlan
    }

    class DailyPlan {
        +list~tuple~Task, int~~ scheduled_tasks
        +list~tuple~Task, str~~ skipped_tasks
        +int total_minutes
        +add_scheduled(task: Task, start_minute: int) None
        +add_skipped(task: Task, reason: str) None
        +explain() str
    }

    Owner "1" --> "1..*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : uses
    Scheduler --> DailyPlan : creates
    DailyPlan o-- Task : contains
