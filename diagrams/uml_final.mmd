classDiagram
    %% Final design, matching pawpal_system.py.
    %% mark_complete() and mark_task_complete() return None when the task does not repeat.

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
        +filter_tasks(pet_name: str, completed: bool) list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +mark_task_complete(title: str) Task
        +edit_task(title: str, duration: int, priority: str) None
        +remove_task(title: str) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str frequency
        +str time
        +bool completed
        +date due_date
        +priority_value() int
        +mark_complete() Task
    }

    class Scheduler {
        +Owner owner
        +sort_tasks(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +detect_conflicts() list~str~
        +generate_plan(start_minute: int) DailyPlan
    }

    class DailyPlan {
        +list~tuple~Task, int~~ scheduled_tasks
        +list~tuple~Task, str~~ skipped_tasks
        +int total_minutes
        +add_scheduled(task: Task, start_minute: int) None
        +add_skipped(task: Task, reason: str) None
        +explain() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Task ..> Task : mark_complete() creates next occurrence
    Pet ..> Task : mark_task_complete() adds next occurrence
    Scheduler --> Owner : reads pets and tasks
    Scheduler ..> DailyPlan : generate_plan() creates
    DailyPlan o-- Task : contains
